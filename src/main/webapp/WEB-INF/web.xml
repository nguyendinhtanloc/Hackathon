<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Smart Mental Wellness Hub</display-name>

    <!-- CORS Filter -->
    <filter>
        <filter-name>CorsFilter</filter-name>
        <filter-class>com.wellness.core.config.CorsFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>CorsFilter</filter-name>
        <url-pattern>/api/*</url-pattern>
    </filter-mapping>

    <!-- DEV 1 - Wellness Servlet -->
    <servlet>
        <servlet-name>WellnessServlet</servlet-name>
        <servlet-class>com.wellness.wellness.servlet.WellnessServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>WellnessServlet</servlet-name>
        <url-pattern>/api/wellness/*</url-pattern>
    </servlet-mapping>

    <!-- DEV 2 - AI Servlet -->
    <servlet>
        <servlet-name>AiCompanionServlet</servlet-name>
        <servlet-class>com.wellness.ai.servlet.AiCompanionServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AiCompanionServlet</servlet-name>
        <url-pattern>/api/ai/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>WellnessLibraryServlet</servlet-name>
        <servlet-class>com.wellness.ai.servlet.WellnessLibraryServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>WellnessLibraryServlet</servlet-name>
        <url-pattern>/api/library/*</url-pattern>
    </servlet-mapping>

    <!-- DEV 3 - Community Servlet -->
    <servlet>
        <servlet-name>CommunityServlet</servlet-name>
        <servlet-class>com.wellness.community.servlet.CommunityServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CommunityServlet</servlet-name>
        <url-pattern>/api/community/*</url-pattern>
    </servlet-mapping>

    <!-- DEV 4 - Academic Servlet -->
    <servlet>
        <servlet-name>AcademicServlet</servlet-name>
        <servlet-class>com.wellness.academic.servlet.AcademicServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AcademicServlet</servlet-name>
        <url-pattern>/api/academic/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>GamificationServlet</servlet-name>
        <servlet-class>com.wellness.academic.servlet.GamificationServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>GamificationServlet</servlet-name>
        <url-pattern>/api/game/*</url-pattern>
    </servlet-mapping>

    <!-- Error Pages -->
    <error-page>
        <error-code>404</error-code>
        <location>/error/404.html</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/error/500.html</location>
    </error-page>

</web-app>
