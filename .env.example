# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# AWS Rekognition Configuration for Facial Emotion Detection
# Get these values from AWS Console: https://console.aws.amazon.com/iam/
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=us-east-1

# How to get AWS credentials:
# 1. Go to AWS Console: https://console.aws.amazon.com/
# 2. Navigate to IAM > Users
# 3. Create a new user or use existing one
# 4. Attach policy: AmazonRekognitionFullAccess
# 5. Create access key (Access key ID + Secret access key)
# 6. Set as environment variables in Tomcat:
#    - IntelliJ: Run > Edit Configurations > Environment Variables
#    - Standalone Tomcat: edit setenv.sh/setenv.bat

# Note: Never commit actual credentials to Git!

# Database (PostgreSQL)
DB_HOST=db.your-project.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-database-password

# AI API Keys
OPENAI_API_KEY=your-openai-key
# or
GEMINI_API_KEY=your-gemini-key

# Application
APP_PORT=8080
APP_ENV=development

# Crisis Hotline
CRISIS_HOTLINE=1800-123-456
