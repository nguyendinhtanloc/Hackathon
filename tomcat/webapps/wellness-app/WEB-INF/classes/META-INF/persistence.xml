<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="http://xmlns.jcp.org/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/persistence
             http://xmlns.jcp.org/xml/ns/persistence/persistence_2_2.xsd"
             version="2.2">

    <persistence-unit name="WellnessPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- Scan all entities -->
        <class>com.wellness.core.entity.BaseEntity</class>
        <!-- DEV 1 entities -->
        <class>com.wellness.wellness.entity.MoodCheckinEntity</class>
        <class>com.wellness.wellness.entity.WellnessScoreEntity</class>
        <!-- DEV 2 entities -->
        <class>com.wellness.ai.entity.ConversationEntity</class>
        <class>com.wellness.ai.entity.WellnessContentEntity</class>
        <!-- DEV 3 entities -->
        <class>com.wellness.community.entity.ForumPostEntity</class>
        <class>com.wellness.community.entity.SupportGroupEntity</class>
        <!-- DEV 4 entities -->
        <class>com.wellness.academic.entity.UserTaskEntity</class>
        <class>com.wellness.academic.entity.ChallengeEntity</class>

        <properties>
            <!-- Supabase PostgreSQL Connection -->
            <!-- Supabase PostgreSQL (Connection Pooler) -->
            <property name="javax.persistence.jdbc.driver" value="org.postgresql.Driver"/>
            <property name="javax.persistence.jdbc.url"
                      value="jdbc:postgresql://aws-1-ap-south-1.pooler.supabase.com:6543/postgres"/>
            <property name="javax.persistence.jdbc.user" value="postgres.gzyislacrggkyllvahwa"/>
            <property name="javax.persistence.jdbc.password" value="JNZwG6GVVy8RhMMV"/>


            <!-- Hibernate Settings -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>

            <!-- Connection Pool -->
            <property name="hibernate.c3p0.min_size" value="5"/>
            <property name="hibernate.c3p0.max_size" value="20"/>
            <property name="hibernate.c3p0.timeout" value="300"/>
        </properties>
    </persistence-unit>
</persistence>